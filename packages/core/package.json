{
  "name": "@agenda/core",
  "version": "1.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./next-fonts": {
      "types": "./src/fonts/next-fonts.ts",
      "default": "./src/fonts/next-fonts.ts"
    }
  },
  "scripts": {
    "build": "echo 'core is a source-only internal package — nothing to build'",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > src/types/database.types.ts",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@agenda/typescript-config": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ts-jest": "^29.2.5",
    "typescript": "^6.0.3"
  }
}
