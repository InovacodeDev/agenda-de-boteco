{
  "name": "agenda-de-boteco",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ota": "node --test --experimental-strip-types scripts/ota/test/*.test.mjs supabase/functions/_shared/ota/*.test.ts",
    "ota:publish": "node scripts/ota/publish.mjs",
    "ota:prune": "node scripts/ota/prune.mjs",
    "ota:rollback": "node scripts/ota/rollback.mjs",
    "test:verify-lock": "node scripts/spec-lock/cli.mjs verify",
    "test:lock-new": "node scripts/spec-lock/cli.mjs lock-new",
    "test:approve-spec-change": "node scripts/spec-lock/cli.mjs approve",
    "test:spec-lock-tooling": "node --test scripts/spec-lock/lib.test.mjs scripts/spec-lock/cli.test.mjs",
    "dev": "bash scripts/sync-env.bash && turbo run dev",
    "dev:web": "pnpm --filter @agenda/web dev",
    "dev:admin": "pnpm --filter @agenda/admin dev",
    "dev:landing": "pnpm --filter @agenda/landing dev",
    "dev:mobile": "pnpm --filter @agenda/mobile start",
    "dev:mobile-client": "pnpm --filter @agenda/mobile-client start",
    "cleanup": "bash scripts/cleanup.bash",
    "build:mobile": "bash scripts/build-mobile.bash",
    "prepare": "husky"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "9.1.7",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.32.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "postcss@<8.5.18": "^8.5.18",
      "browserslist@<4.28.7": "^4.28.7",
      "form-data@<4.0.6": "^4.0.6",
      "sharp@<0.35.5": "^0.35.5",
      "shell-quote@<1.11.0": "^1.11.0",
      "handlebars@<4.7.10": "^4.7.10",
      "source-map-js@<1.2.2": "^1.2.2",
      "compression@<1.8.2": "^1.8.2",
      "dompurify@<3.4.16": "^3.4.16",
      "nanoid@<3.3.18": "^3.3.18",
      "js-yaml@>=4 <4.3.1": "^4.3.1",
      "uuid@<11.1.1": "^11.1.1",
      "@xmldom/xmldom@>=0.9 <0.9.12": "^0.9.12"
    },
    "patchedDependencies": {
      "react-native-css@0.0.0-nightly.5ce6396": "patches/react-native-css@0.0.0-nightly.5ce6396.patch"
    }
  }
}
