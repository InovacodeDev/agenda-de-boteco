# Admin (Vite) — exposed to the browser, prefix VITE_
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Tooling — used by `pnpm --filter core gen:types` (never shipped to clients)
SUPABASE_PROJECT_ID=your-project-id
OTA_PUBLIC_BASE_URL=
OTA_PRIVATE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agenda-ota
