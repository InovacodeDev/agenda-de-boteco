branch="$(git symbolic-ref --short HEAD 2>/dev/null)"

case "$branch" in
  alfa|beta|release)
    echo "❌ Commit direto bloqueado na branch '$branch'. Crie uma branch derivada da feature antes de codificar."
    exit 1
    ;;
esac

bash scripts/hooks/check-audit-log.bash

node scripts/spec-lock/cli.mjs verify
node scripts/spec-lock/cli.mjs lock-new --stage
pnpm turbo run test --filter='...[HEAD]'
