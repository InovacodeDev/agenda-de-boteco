# URLs de destino dos rewrites (usadas pelo vercel.json em produção).
# Em dev os apps rodam nas portas diretas (web :8088, admin :8089, client :8090, artists :8091).
NEXT_PUBLIC_SITE_URL=http://localhost:8087
NEXT_PUBLIC_WEB_URL=http://localhost:8088
NEXT_PUBLIC_ADMIN_URL=http://localhost:8089
NEXT_PUBLIC_WEB_CLIENT_URL=http://localhost:8090
NEXT_PUBLIC_ARTISTS_URL=http://localhost:8091

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Upload de source maps ao PostHog: só CI/build (Vercel Production). Server-only, nunca NEXT_PUBLIC_.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
