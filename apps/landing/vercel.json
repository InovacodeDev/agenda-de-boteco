{
  "rewrites": [
    {
      "source": "/app",
      "destination": "https://agenda-de-boteco-web.vercel.app/app"
    },
    {
      "source": "/app/:path*",
      "destination": "https://agenda-de-boteco-web.vercel.app/app/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://agenda-de-boteco-admin.vercel.app/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://agenda-de-boteco-admin.vercel.app/admin/:path*"
    },
    {
      "source": "/artists",
      "destination": "https://agenda-de-boteco-web-artists.vercel.app/artists"
    },
    {
      "source": "/artists/:path*",
      "destination": "https://agenda-de-boteco-web-artists.vercel.app/artists/:path*"
    },
    {
      "source": "/client",
      "destination": "https://agenda-de-boteco-web-client.vercel.app/client"
    },
    {
      "source": "/client/:path*",
      "destination": "https://agenda-de-boteco-web-client.vercel.app/client/:path*"
    }
  ]
}
