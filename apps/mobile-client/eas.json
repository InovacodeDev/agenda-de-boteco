{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "alfa"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production"
    },
    "alfa": {
      "extends": "production",
      "environment": "preview",
      "channel": "alfa"
    },
    "beta": {
      "extends": "production",
      "environment": "preview",
      "channel": "beta"
    }
  }
}
