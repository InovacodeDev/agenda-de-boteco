{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "alfa"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production"
    },
    "alfa": {
      "extends": "production",
      "environment": "preview",
      "channel": "alfa"
    },
    "beta": {
      "extends": "production",
      "environment": "preview",
      "channel": "beta"
    }
  },
  "submit": {
    "alfa": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "ascAppId": "$ASC_APP_ID"
      }
    },
    "beta": {
      "android": {
        "track": "beta"
      },
      "ios": {
        "ascAppId": "$ASC_APP_ID"
      }
    },
    "production": {
      "android": {
        "track": "production"
      },
      "ios": {
        "ascAppId": "$ASC_APP_ID"
      }
    }
  }
}
