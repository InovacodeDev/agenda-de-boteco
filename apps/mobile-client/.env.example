# Base da web pública do consumidor, usada para abrir a página do evento (ex: https://seuapp.com/app).
EXPO_PUBLIC_WEB_URL=

# Analytics e feature flags (PostHog). Use a MESMA key/host do web-client
# (NEXT_PUBLIC_POSTHOG_KEY/HOST): as flags panel-* bloqueiam telas nos dois painéis.
# Sem key, o app roda sem analytics e as telas com flag ficam bloqueadas.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Upload de source maps/símbolos nativos (posthog-cli). Só CI/build (EAS env preview/production,
# visibilidade secret) — nunca no git. Sem POSTHOG_CLI_API_KEY o plugin não é aplicado.
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_HOST=

EXPO_PUBLIC_OTA_MANIFEST_URL=

