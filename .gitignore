# =============================================================================
#  .gitignore — Turborepo monorepo (Expo/RN + Vite + Supabase)
#  Root-level. Patterns use **/ where they must match inside any workspace.
#  NOTE: pnpm-lock.yaml is intentionally NOT ignored — lockfiles must be committed.
# =============================================================================

# -----------------------------------------------------------------------------
#  Dependencies
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
.npm/

# -----------------------------------------------------------------------------
#  Git worktrees (superpowers subagent-driven development)
# -----------------------------------------------------------------------------
.worktrees/

# -----------------------------------------------------------------------------
#  ENVIRONMENT & SECRETS  —  NEVER commit these
#  (Supabase service_role key, anon key, API tokens, etc. live here)
# -----------------------------------------------------------------------------
.env
.env.*
*.local
!.env.example
!.env.*.example

# Keys, certificates & signing material
*.pem
*.key
*.p8
*.p12
*.pfx
*.cer
*.der
*.mobileprovision
*.provisionprofile
*.certSigningRequest
*.jks
*.keystore
!debug.keystore        # Android debug keystore is not secret; allow it if present

# -----------------------------------------------------------------------------
#  Turborepo
# -----------------------------------------------------------------------------
.turbo/

# -----------------------------------------------------------------------------
#  Build outputs / TypeScript
# -----------------------------------------------------------------------------
dist/
build/
*.tsbuildinfo
.eslintcache
*.tgz

# -----------------------------------------------------------------------------
#  Expo / React Native  (apps/mobile)
# -----------------------------------------------------------------------------
.expo/
.expo-shared/
expo-env.d.ts          # auto-generated by Expo
web-build/             # legacy expo web export (new output goes to dist/)
.metro-health-check*
*.orig.*

# -----------------------------------------------------------------------------
#  Native — iOS  (only present after prebuild / in bare projects)
# -----------------------------------------------------------------------------
**/ios/.xcode.env.local
**/ios/Pods/
**/ios/build/
**/ios/DerivedData/
**/ios/*.xcuserstate
**/*.xcuserdata/
**/*.pbxuser

# -----------------------------------------------------------------------------
#  Native — Android
# -----------------------------------------------------------------------------
**/android/.gradle/
**/android/.cxx/
**/android/build/
**/android/app/build/
**/android/local.properties
**/android/.kotlin/
*.apk
*.aab

# If you use Expo Continuous Native Generation (prebuild) and DON'T edit native
# code by hand, the whole native dirs are regenerated — uncomment to ignore them:
# **/ios/
# **/android/

# -----------------------------------------------------------------------------
#  EAS (Expo Application Services)
# -----------------------------------------------------------------------------
credentials.json                 # references local keystore/passwords — keep out of git
# google-services.json           # uncomment if you inject these via EAS secrets
# **/GoogleService-Info.plist     # instead of committing them

# -----------------------------------------------------------------------------
#  Vite  (apps/admin)
# -----------------------------------------------------------------------------
.vite/

# -----------------------------------------------------------------------------
#  Supabase CLI  (keep config.toml + migrations; ignore local state/secrets)
# -----------------------------------------------------------------------------
supabase/.branches/
supabase/.temp/
supabase/.env

# -----------------------------------------------------------------------------
#  Sentry  (build-time auth tokens)
# -----------------------------------------------------------------------------
.sentryclirc
.env.sentry-build-plugin

# -----------------------------------------------------------------------------
#  Testing / coverage
# -----------------------------------------------------------------------------
coverage/
.nyc_output/

# -----------------------------------------------------------------------------
#  Logs & caches
# -----------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
.cache/

# -----------------------------------------------------------------------------
#  OS files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
#  Editors / IDEs
# -----------------------------------------------------------------------------
.idea/
*.iml
*.swp
*.swo
*~
.history/

# VS Code — ignore the folder EXCEPT the shared, committed configs
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/*.code-snippets
# -----------------------------------------------------------------------------
#  Native — CNG (Continuous Native Generation): prebuild output is disposable
# -----------------------------------------------------------------------------
apps/mobile/ios/
apps/mobile/android/
