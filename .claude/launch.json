{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@agenda/mobile", "exec", "expo", "start", "--web"],
      "autoPort": true
    },
    {
      "name": "agenda-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@agenda/web", "dev"],
      "port": 8088
    },
    {
      "name": "agenda-admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@agenda/admin", "dev"],
      "port": 8089
    }
  ]
}
