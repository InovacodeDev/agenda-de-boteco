{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@agenda/mobile", "exec", "expo", "start", "--web"],
      "autoPort": true
    },
    {
      "name": "agenda-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@agenda/web", "dev"],
      "port": 8088
    },
    {
      "name": "agenda-admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@agenda/admin", "dev"],
      "port": 8089
    },
    {
      "name": "agenda-web-client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@agenda/web-client", "dev"],
      "port": 8090
    },
    {
      "name": "agenda-landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@agenda/landing", "dev"],
      "port": 8087
    },
    {
      "name": "agenda-web-artists",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@agenda/web-artists", "dev"],
      "port": 8091
    }
  ]
}
